# Same Supabase project as the web app — use the values from
# un1t-crm/.env.local. The EXPO_PUBLIC_ prefix is required for Expo to
# bundle them into the JS at build time (only safe for non-secret keys
# like the anon key).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base URL for the deployed Next.js API. Mobile calls a small subset of
# /api/* routes for orchestration (push registration, assistant chat,
# WhatsApp send). For local development point this at http://localhost:3000
# and use a tunnel (e.g. expo's --tunnel flag) so the simulator can reach it.
EXPO_PUBLIC_API_BASE_URL=https://crm.repset.ie

# Base URL for the member-app (champ) deployment — the merged app still
# calls a few member-facing /api/* routes there (see app.config.js
# extra.champApiBaseUrl).
EXPO_PUBLIC_CHAMP_API_BASE_URL=https://api.repset.ie

# EAS project ID — populated automatically by `eas init`. Required for
# production push notifications. Optional during Expo Go development.
EAS_PROJECT_ID=
