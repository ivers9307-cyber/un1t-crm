{
  "name": "[SYNC] Lifecycle Management → CRM — v5",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-deal-update",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "crm-webhook",
      "name": "CRM: Deal Updated Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "webhookId": "crm-deal-update"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst body = payload.body || payload;\nconst current = body.current || {};\nconst stageId = current.stage_id;\nconst status = current.status;\nconst isCold = status === 'lost';\n// Look up contact details from CRM\nreturn [{ json: {\n  is_cold: isCold, contact_id: current.contact_id,\n  deal_id: current.id, stage_id: stageId, status\n}}];"
      },
      "id": "detect-cold",
      "name": "Detect Cold/Lost Deal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/{{ $json.contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-fetch-cold-contact",
      "name": "CRM: Fetch Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Detect Cold/Lost Deal').first().json;\nconst contact = $input.first().json.data || {};\nreturn [{ json: { ...prev, email: contact.email, phone: contact.phone, name: contact.name } }];"
      },
      "id": "merge-cold-data",
      "name": "Merge Contact Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "cold-check",
              "leftValue": "={{ $json.is_cold }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-cold",
      "name": "Is Cold/Lost?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/{{ $json.contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"label\": \"Cold — Email Only\", \"lead_status\": \"cold\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-tag-cold",
      "name": "CRM: Tag Cold + Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        250
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst body = payload.body || payload;\nconst email = body.data?.subscriber?.email || body.email || '';\nreturn [{ json: {\n  email, name: body.data?.subscriber?.fields?.name || '',\n  phone: body.data?.subscriber?.fields?.phone || '',\n  event_type: body.type || 'subscriber.clicked',\n  campaign_name: body.data?.campaign?.name || 'Unknown'\n}}];"
      },
      "id": "parse-reengage",
      "name": "Parse Re-engagement Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        600
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "term",
              "value": "={{ $json.email }}"
            },
            {
              "name": "fields",
              "value": "email"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-lookup-reengage",
      "name": "CRM: Lookup Person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        600
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Parse Re-engagement Event').first().json;\nconst result = $input.first().json;\nconst contact = result.data?.items?.[0]?.item || {};\nconst leadStatus = contact.lead_status || '';\nconst isLostMember = leadStatus === 'lost_member';\nconst newStatus = isLostMember ? 'returning' : 'active_trial';\nconst newTag = isLostMember ? 'Returning Member' : 'Re-engaged Lead';\nreturn [{ json: {\n  ...lead, contact_id: contact.id || null,\n  current_status: leadStatus,\n  is_lost_member: isLostMember,\n  new_status: newStatus, new_tag: newTag\n}}];"
      },
      "id": "classify-reengage",
      "name": "Classify Re-engagement Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        600
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/{{ $json.contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"label\": \"{{ $json.new_tag }}\", \"lead_status\": \"{{ $json.new_status }}\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-reactivate",
      "name": "CRM: Update Status + Label",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        650
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"contact_id\": \"{{ $json.contact_id }}\", \"content\": \"Re-engaged on {{ $now.setZone('Europe/Dublin').toFormat('yyyy-MM-dd HH:mm') }}\\nTriggered by: {{ $('Parse Re-engagement Event').first().json.campaign_name }}\\nType: {{ $json.new_tag }}\\nStatus updated: {{ $json.current_status }} → {{ $json.new_status }}\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-reengage-note",
      "name": "CRM: Re-engagement Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        650
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "glofox-cancellation",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "glofox-cancel-webhook",
      "name": "Glofox: Membership Cancelled Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        1000
      ],
      "webhookId": "glofox-cancellation"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst body = payload.body || payload;\nreturn [{ json: {\n  member_id: body.member_id || body.data?.member_id || '',\n  name: body.member_name || body.data?.member_name || '',\n  email: (body.member_email || body.data?.member_email || '').toLowerCase().trim(),\n  phone: body.member_phone || body.data?.member_phone || '',\n  cancellation_reason: body.reason || body.data?.reason || 'Not provided',\n  cancellation_date: new Date().toISOString()\n}}];"
      },
      "id": "parse-cancel",
      "name": "Parse Cancellation Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        1000
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "term",
              "value": "={{ $json.email }}"
            },
            {
              "name": "fields",
              "value": "email"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-lookup-cancel",
      "name": "CRM: Find Cancelled Member",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        1000
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const cancelData = $('Parse Cancellation Event').first().json;\nconst result = $input.first().json;\nconst contact = result.data?.items?.[0]?.item || {};\nreturn [{ json: { ...cancelData, contact_id: contact.id || null } }];"
      },
      "id": "merge-cancel",
      "name": "Merge Cancel Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        1000
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/{{ $json.contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"label\": \"Lost Member\", \"lead_status\": \"lost_member\", \"trial_credits_remaining\": 0 }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-lost-member",
      "name": "CRM: Tag Lost + Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        950
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/notes",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"contact_id\": \"{{ $json.contact_id }}\", \"content\": \"Membership cancelled on {{ $json.cancellation_date }}\\nReason: {{ $json.cancellation_reason }}\\nLead Status → lost_member\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-cancel-note",
      "name": "CRM: Cancellation Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1380,
        950
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    }
  ],
