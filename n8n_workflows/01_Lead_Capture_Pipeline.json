    {
      "parameters": {
        "jsCode": "// Calendly v2 webhook (invitee.created event)\nconst raw = $input.first().json;\nconst body = raw.body || raw;\nconst invitee = body.payload || body;\nconst questions = invitee.questions_and_answers || [];\nlet phone = '';\nfor (const q of questions) {\n  const qText = (q.question || '').toLowerCase();\n  if (qText.includes('phone') || qText.includes('mobile')) phone = q.answer || '';\n}\nphone = phone.replace(/[\\s\\-\\(\\)]/g, '');\nif (phone.startsWith('0')) phone = '+353' + phone.substring(1);\nelse if (!phone.startsWith('+')) phone = '+353' + phone;\nconst name = invitee.name || '';\nreturn [{ json: {\n  name, first_name: name.split(' ')[0] || '', last_name: name.split(' ').slice(1).join(' ') || '',\n  email: (invitee.email || '').toLowerCase().trim(), phone,\n  lead_source: 'calendly',\n  event_type: invitee.event_type_name || 'Trial Class',\n  booking_time: invitee.scheduled_event?.start_time || '',\n  created_at: new Date().toISOString()\n}}];"
      },
      "id": "normalize-calendly",
      "name": "Normalize Calendly Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json;\nconst body = payload.body || payload;\nconst fields = body.field_data || [];\nlet name = '', email = '', phone = '';\nfor (const f of fields) {\n  if (f.name === 'full_name') name = f.values?.[0] || '';\n  if (f.name === 'email') email = f.values?.[0] || '';\n  if (f.name === 'phone_number') phone = f.values?.[0] || '';\n}\nname = name || body.name || body.full_name || '';\nemail = email || body.email || '';\nphone = phone || body.phone || body.phone_number || '';\nphone = phone.replace(/[\\s\\-\\(\\)]/g, '');\nif (phone.startsWith('0')) phone = '+353' + phone.substring(1);\nelse if (!phone.startsWith('+')) phone = '+353' + phone;\nlet lead_source = 'meta';\nif (body.source === 'tiktok' || body.ad_platform === 'tiktok') lead_source = 'tiktok';\nreturn [{ json: {\n  name, first_name: name.split(' ')[0] || '', last_name: name.split(' ').slice(1).join(' ') || '',\n  email: email.toLowerCase().trim(), phone, lead_source,\n  event_type: 'Social Lead Form', booking_time: '',\n  created_at: new Date().toISOString()\n}}];"
      },
      "id": "normalize-social",
      "name": "Normalize Social Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        500
      ]
    },
