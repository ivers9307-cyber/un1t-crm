    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst errors = [];\nif (!lead.email || !lead.email.includes('@')) errors.push('Invalid email');\nif (!lead.phone || lead.phone.length < 8) errors.push('Invalid phone');\nif (!lead.name) errors.push('Missing name');\nif (errors.length > 0) return [{ json: { ...lead, valid: false, validation_errors: errors } }];\nreturn [{ json: { ...lead, valid: true, validation_errors: [] } }];"
      },
