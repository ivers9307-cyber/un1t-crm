{
  "name": "[SYNC] Credit Tracking & Class Attendance → CRM — v5",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Every Hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "lead_status",
              "value": "active_trial"
            },
            {
              "name": "min_credits",
              "value": "0"
            },
            {
              "name": "limit",
              "value": "100"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "crm-get-trials",
      "name": "CRM: Get Active Trial Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst contacts = response.data || [];\nif (contacts.length === 0) return [{ json: { action: 'no_leads' } }];\nreturn contacts.map(c => ({ json: {\n  contact_id: c.id, name: c.name || '', first_name: c.first_name || '',\n  email: c.email || '', phone: c.phone || '',\n  glofox_user_id: c.glofox_member_id || '',\n  last_known_credits: c.trial_credits_remaining ?? 3,\n  lead_source: c.lead_source || '', lead_status: c.lead_status || ''\n}}));"
      },
      "id": "extract-persons",
      "name": "Extract Contact Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true
          },
          "conditions": [
            {
              "id": "has-glofox",
              "leftValue": "={{ $json.glofox_user_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-has-glofox",
      "name": "Filter: Has Glofox ID",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-leads",
      "name": "Loop Through Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1120,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://gf-api.aws.glofox.com/prod/2.0/credits",
        "authentication": "noAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_id",
              "value": "={{ $json.glofox_user_id }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-glofox-branch-id",
              "value": "REPLACE_WITH_BRANCH_ID"
            },
            {
              "name": "x-api-key",
              "value": "REPLACE_WITH_GLOFOX_API_KEY"
            },
            {
              "name": "x-glofox-api-token",
              "value": "REPLACE_WITH_GLOFOX_API_TOKEN"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "glofox-check-credits",
      "name": "Glofox: Check Credits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// NOTE: Glofox credits endpoint is UNCONFIRMED — verify with Glofox support\nconst lead = $('Loop Through Leads').first().json;\nconst cr = $input.first().json;\nconst currentCredits = cr.data?.total ?? cr.data?.credits_remaining ?? cr.total ?? cr.credits ?? 0;\nconst lastKnown = lead.last_known_credits;\nif (currentCredits === lastKnown) return [{ json: { ...lead, action: 'no_change', current_credits: currentCredits } }];\nlet action = 'no_change', whatsapp_template = '', stage_slug = '';\nif (currentCredits === 2) { action = 'first_class'; whatsapp_template = 'after_first_class'; stage_slug = 'trial_active'; }\nelse if (currentCredits === 1) { action = 'second_class'; whatsapp_template = 'after_second_class'; }\nelse if (currentCredits === 0) { action = 'third_class'; whatsapp_template = 'after_third_class'; stage_slug = 'conversion_ready'; }\nreturn [{ json: { ...lead, action, whatsapp_template, stage_slug, current_credits: currentCredits } }];"
      },
      "id": "compare-credits",
      "name": "Compare Credits",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        200
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/contacts/{{ $json.contact_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"trial_credits_remaining\": {{ $json.current_credits }} }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-update-credits",
      "name": "CRM: Update Credits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputIndex": 0,
              "value": "first_class"
            },
            {
              "outputIndex": 1,
              "value": "second_class"
            },
            {
              "outputIndex": 2,
              "value": "third_class"
            },
            {
              "outputIndex": 3,
              "value": "no_change"
            }
          ]
        },
        "dataType": "string",
        "value": "={{ $json.action }}"
      },
      "id": "switch-action",
      "name": "Switch: Touchpoint",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        2000,
        200
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      },
      "id": "wait-rate-limit",
      "name": "Wait: Rate Limit",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/deals/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "term",
              "value": "={{ $json.email }}"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-lookup-1",
      "name": "CRM: Lookup Deal (1st)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { deal_id: r.data?.items?.[0]?.item?.id } }];"
      },
      "id": "extract-deal-1",
      "name": "Extract Deal (1st)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        120
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/deals/{{ $json.deal_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"stage_slug\": \"trial_active\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-trial-active",
      "name": "CRM: Trial Active",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2700,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/activities",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subject\": \"Personal reach out — {{ $('Compare Credits').first().json.name }} (1 credit left)\",\n  \"type\": \"call\",\n  \"contact_id\": \"{{ $('Compare Credits').first().json.contact_id }}\",\n  \"due_date\": \"{{ $now.plus({days: 1}).toFormat('yyyy-MM-dd') }}\",\n  \"due_time\": \"10:00\",\n  \"note\": \"2 of 3 trial credits used. 1 remaining. Personal outreach recommended.\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-outreach",
      "name": "CRM: Staff Outreach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/deals/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "term",
              "value": "={{ $('Compare Credits').first().json.email }}"
            },
            {
              "name": "limit",
              "value": "1"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-lookup-3",
      "name": "CRM: Lookup Deal (3rd)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        680
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { deal_id: r.data?.items?.[0]?.item?.id } }];"
      },
      "id": "extract-deal-3",
      "name": "Extract Deal (3rd)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        680
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=REPLACE_WITH_CRM_BASE_URL/api/deals/{{ $json.deal_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"stage_slug\": \"conversion_ready\" }",
        "options": {
          "timeout": 10000
        }
      },
      "id": "crm-conversion-ready",
      "name": "CRM: Conversion Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2700,
        680
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CRM_API_KEY",
          "name": "CRM API Key"
        }
      }
    }
  ],
  "connections": {
    "Every Hour": {
      "main": [
        [
          {
            "node": "CRM: Get Active Trial Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Get Active Trial Leads": {
      "main": [
        [
          {
            "node": "Extract Contact Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Contact Data": {
      "main": [
        [
          {
            "node": "Filter: Has Glofox ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter: Has Glofox ID": {
      "main": [
        [
          {
            "node": "Loop Through Leads",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Loop Through Leads": {
      "main": [
        [
          {
            "node": "Glofox: Check Credits",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Glofox: Check Credits": {
      "main": [
        [
          {
            "node": "Compare Credits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compare Credits": {
      "main": [
        [
          {
            "node": "CRM: Update Credits",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Update Credits": {
      "main": [
        [
          {
            "node": "Switch: Touchpoint",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Switch: Touchpoint": {
      "main": [
        [
          {
            "node": "CRM: Lookup Deal (1st)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CRM: Staff Outreach",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CRM: Lookup Deal (3rd)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait: Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait: Rate Limit": {
      "main": [
        [
          {
            "node": "Loop Through Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Lookup Deal (1st)": {
      "main": [
        [
          {
            "node": "Extract Deal (1st)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Deal (1st)": {
      "main": [
        [
          {
            "node": "CRM: Trial Active",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Trial Active": {
      "main": [
        [
          {
            "node": "Wait: Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Staff Outreach": {
      "main": [
        [
          {
            "node": "Wait: Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Lookup Deal (3rd)": {
      "main": [
        [
          {
            "node": "Extract Deal (3rd)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Deal (3rd)": {
      "main": [
        [
          {
            "node": "CRM: Conversion Ready",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM: Conversion Ready": {
      "main": [
        [
          {
            "node": "Wait: Rate Limit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "tags": [
    {
      "name": "sync"
    },
    {
      "name": "production"
    }
  ]
}
