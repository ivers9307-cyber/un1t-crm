{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0,
    "types": [],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"], "@shared/*": ["./shared/*"] }
  }
}
