# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Auth (used by n8n to call CRM endpoints)
CRM_API_KEY=generate-a-secure-random-string-here

# Cron auth (used by Vercel cron → /api/cron/*)
CRON_SECRET=generate-a-secure-random-string-here

# App URL (used in email templates, unsubscribe URLs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buyer-facing payment domain — used when generating car-deposit links
# and the Revolut redirect_url. Lives on the same Vercel project as the
# CRM but middleware blocks every path except /cars/deposit/* there.
# Production: https://pay.ccfautos.com
DEPOSIT_BASE_URL=http://localhost:3000
# Same value, but exposed to the browser bundle so operator-side links
# (e.g. 'View public deposit page' on the car detail) point to the
# right hostname.
NEXT_PUBLIC_DEPOSIT_BASE_URL=http://localhost:3000
# Hostname the middleware should treat as the pay subdomain. On this
# host ONLY /cars/deposit/* and /api/public/deposit/* are reachable —
# every other path returns 404 to keep the CRM invisible from the
# customer-facing brand. Defaults to 'pay.ccfautos.com' if unset.
PAY_HOSTNAME=pay.ccfautos.com

# Postmark (transactional + broadcast email)
POSTMARK_API_KEY=your-postmark-server-token
POSTMARK_FROM_EMAIL=hello@un1t.ie
# Shared secret for Postmark webhook auth. After setting this, configure
# Postmark → Webhooks → Custom Headers to send X-Webhook-Token: <this value>.
# If unset, webhooks are accepted with a warning (dev/rollout only).
POSTMARK_WEBHOOK_TOKEN=generate-a-secure-random-string-here

# Twilio SMS (car-deposit link delivery)
# Account SID + Auth Token from twilio.com/console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Sender shown to the recipient. Three formats accepted:
#   - alphanumeric ID (max 11 chars, e.g. 'CCFautos') — free, one-way only
#   - E.164 phone number (e.g. '+35315550000') — rented from Twilio
#   - Messaging Service SID ('MGxxx...') — Twilio routes automatically
# Defaults to 'CCFautos' if unset.
TWILIO_FROM=CCFautos

# Revolut Merchant API (car deposit feature)
# Sandbox: https://sandbox-merchant.revolut.com  + sandbox API key
# Prod:    https://merchant.revolut.com          + live API key
REVOLUT_API_KEY=your-merchant-api-secret-key
REVOLUT_API_BASE_URL=https://sandbox-merchant.revolut.com
# Webhook signing secret returned when you POST /v1/webhooks (or via GET).
# Used to verify Revolut-Signature on POST /api/webhooks/revolut.
REVOLUT_WEBHOOK_SECRET=your-revolut-webhook-secret
# Optional override; defaults to 2026-03-12 in src/lib/revolut.js.
REVOLUT_API_VERSION=2026-03-12
# Browser mode for the embedded checkout widget — picks which embed.js
# script to load. 'sandbox' (default) → sandbox-merchant.revolut.com.
# 'prod' → merchant.revolut.com. Must match REVOLUT_API_BASE_URL above.
NEXT_PUBLIC_REVOLUT_MODE=sandbox

# Revolut PUBLIC API key (pk_sandbox_... or pk_live_...). Different
# from REVOLUT_API_KEY (which is the SECRET key for server calls). The
# public key is exposed to the browser bundle — that's fine and
# expected; Revolut's docs are explicit that the public key is
# 'provided with payment methods at checkout'. Used to initialise the
# embeddedCheckout widget. Generate alongside the secret key in
# Revolut Business → APIs → Merchant API.
NEXT_PUBLIC_REVOLUT_PUBLIC_KEY=pk_sandbox_your_public_key_here

# WhatsApp Cloud API (Meta v21.0)
WHATSAPP_ACCESS_TOKEN=your-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# Meta App ID — required for the Resumable Upload API used when a
# template has an IMAGE / VIDEO / DOCUMENT header. Find it in:
# Meta App Dashboard → Settings → Basic → App ID. Without this, media
# template uploads fall back to storage-only and the template can't
# be submitted to Meta for approval.
WHATSAPP_APP_ID=your-meta-app-id
# Token Meta sends in the GET subscription handshake. Set the same value in
# Meta App Dashboard → WhatsApp → Configuration → Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=generate-a-secure-random-string-here
# WhatsApp App Secret — Meta App Dashboard → Settings → Basic → App Secret.
# Used to verify X-Hub-Signature-256 on incoming webhooks. If unset, webhooks
# are accepted with a warning (dev/rollout only).
WHATSAPP_APP_SECRET=your-meta-app-secret
# Embedded Signup v4 config id (Connect with WhatsApp) — Meta App Dashboard →
# Facebook Login for Business → Configurations. Unset = the connect button
# renders a "not configured" state.
WHATSAPP_ES_CONFIG_ID=your-es-config-id

# Glofox integration (GLOFOX1, mig 132)
# Per-location credentials live on locations.settings.glofox —
# operator pastes Branch ID, API Key, API Token, and Webhook
# Secret in Settings → Locations → (location) → Glofox Integration.
# Nothing per-location lives in env any more. Only the global
# dark-launch toggle stays here.
#
# Dark-launch toggle for the inbound /api/webhooks/glofox receiver.
# 'true' = verify HMAC + audit the row + 200 OK without applying
# tags or firing sequences. Use during initial rollout to capture
# real payload shapes before wiring action paths. Set to 'false'
# (or remove) to go live.
GLOFOX_DARK_LAUNCH=true
