node_modules/
.next/
.env
.env.local

# Internal review/session artefacts — not source
_review/

# Personal per-commit message scripts under scripts/ — generated
# locally to draft each commit's message, never meant to be checked
# in. Matches the `_<short-name>-commit.mjs` convention.
scripts/_*-commit.mjs

# EAS Update code-signing private key (MOBILE-AUDIT.2) — never commit
mobile/keys/

# graphify knowledge-graph output — generated locally (~8MB), never source
graphify-out/
.superpowers/

# Claude Code agent worktrees — transient subagent workspaces, never source
.claude/worktrees/

# ffmpeg.wasm core/worker — self-hosted at install time (~25MB), never committed
public/ffmpeg/
evals/output/
