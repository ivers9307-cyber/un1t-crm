{
  "name": "un1t-crm",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cross-tenant": "vitest run tests/cross-tenant",
    "check:mobile-parity": "node scripts/check-mobile-parity.mjs",
    "check:mobile-imports": "eslint --config eslint.mobile-imports.config.mjs 'mobile/**/*.{js,jsx}'",
    "check:mobile-lint": "eslint --config eslint.mobile.config.mjs 'mobile/**/*.{js,jsx,mjs}' --max-warnings 0",
    "check:route-guards": "node scripts/check-route-guards.mjs",
    "check:location-scoping": "node scripts/check-location-scoping.mjs",
    "check:rls-restrictive": "node scripts/check-rls-restrictive.mjs",
    "check:bundle-sql": "node scripts/check-bundle-sql.mjs",
    "check:ota-paths": "node scripts/check-ota-trigger-paths.mjs",
    "check:dependency-audit": "npm audit --omit=dev --audit-level=high --json | node scripts/check-dependency-audit.mjs .audit-allowlist.json 'web runtime deps'",
    "check:dependency-audit:mobile": "cd mobile && npm audit --audit-level=high --package-lock-only --json | node ../scripts/check-dependency-audit.mjs .audit-allowlist.json 'mobile deps (whole tree)'",
    "check:guardrails": "eslint --config eslint.guardrails.config.mjs 'src/**/*.{js,jsx}' 'shared/**/*.js' 'tests/**/*.js'",
    "check:secrets": "node scripts/check-secrets.mjs",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "eval:agent": "vitest run --config vitest.evals.config.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@react-pdf/renderer": "^4.6.1",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.0",
    "heic-convert": "^2.1.0",
    "imapflow": "^1.7.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "stripe": "^22.5.0",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-import": "^2.32.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "$sharp",
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
